<?xml version="1.0"?>
<ruleset name="WP VaaniLog">

	<description>WordPress Coding Standards for WP VaaniLog.</description>

	<!-- Scan these paths. -->
	<file>includes</file>
	<file>wp-vaanilog.php</file>
	<file>uninstall.php</file>

	<!-- Never scan these. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- PHP configuration. -->
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg value="ns"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>

	<config name="testVersion" value="8.1-"/>

	<!-- Use WordPress Coding Standards. -->
	<rule ref="WordPress">

		<!--
			WP VaaniLog uses PSR-4 class filenames.
			Do not enforce WordPress class filename conventions.
		-->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

	</rule>

	<!--
		Short array syntax is intentionally supported by PHP 8.1+.
	-->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<exclude-pattern>*/includes/*</exclude-pattern>
	</rule>

	<!-- WordPress internationalization settings. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-vaanilog"/>
			</property>
		</properties>
	</rule>

	<!-- WP VaaniLog global variable prefixes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="vaanilog"/>
				<element value="VAANILOG"/>
				<element value="WPVaaniLog"/>
			</property>
		</properties>
		
		<exclude-pattern>*/includes/views/*</exclude-pattern>
	</rule>

</ruleset>